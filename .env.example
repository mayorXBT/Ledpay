# Optional PayBox-hosted environment variables (non-secret).
# Configure these in the developer portal under Variables & Secrets.
# Do not put API keys or private keys here.

# Per-call USDC cap on Base. Default: 1
# LEDPAY_MAX_AMOUNT_USDC=1

# Comma-separated recipient allowlist. Empty means any valid EVM address.
# LEDPAY_ALLOWED_RECIPIENTS=0x1111111111111111111111111111111111111111

# Kernel session executor (HTTPS origin). Required for ledpay_session_send.
# Add this host in the PayBox portal Network hosts list when used.
# LEDPAY_EXECUTOR_URL=https://executor.example

# Ledger WebHID onboarding app origin.
# LEDPAY_ONBOARD_URL=https://onboard.example

# Executor-only (never in the plugin bundle):
# LEDPAY_RPC_URL=http://127.0.0.1:8545
# LEDPAY_BUNDLER_URL=http://127.0.0.1:4337
# LEDPAY_EXECUTOR_PORT=8787
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# LEDPAY_ALLOW_TEST_OWNER=1   # local Anvil only; production sudo is the Ledger EOA
